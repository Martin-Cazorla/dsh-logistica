datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
    ADMIN
    WAREHOUSE_MANAGER
    PICKER
    DRIVER
}

enum OrderStatus {
    PENDING
    IN_PICKING
    PICKED
    CHECKED
    DISPATCHED
    DELIVERED
    CANCELLED
}

enum MovementType {
    INBOUND
    OUTBOUND
    TRANSFER_IN
    TRANSFER_OUT
    ADJUSTMENT
}

enum LocationType {
    RECEIVING
    STORAGE
    PICKING
    DISPATCH
}

enum RouteStatus {
    PLANNED
    IN_TRANSIT
    COMPLETED
    CANCELLED
}

enum TaxCondition {
    RESPONSABLE_INSCRIPTO
    MONOTRIBUTO
    EXENTO
    CONSUMIDOR_FINAL
}

enum Currency {
    ARS
    USD
}

enum PaymentTerm {
    CUENTA_CORRIENTE
    CONTADO
    DEPOSITO
}

enum InboundStatus {
    PENDIENTE
    RECIBIDO
    CANCELADO
}

enum CustomerType {
    DISTRIBUTOR
    RETAILER
    DIRECT_CONSUMER
    LOGISTICS_PARTNER
}

// ==========================================
// USUARIOS Y ROLES
// ==========================================

model User {
    id        String   @id @default(uuid()) @db.Uuid
    email     String   @unique @db.VarChar(255)
    password  String   @db.VarChar(255)
    firstName String   @map("first_name") @db.VarChar(100)
    lastName  String   @map("last_name") @db.VarChar(100)
    role      UserRole @default(PICKER)
    isActive  Boolean  @default(true) @map("is_active")

    // Relaciones
    assignedOrders         Order[]                @relation("PickerOrders")
    salesOrders            Order[]                @relation("SellerOrders")
    routes                 Route[]                @relation("DriverRoutes")
    movements              StockMovement[]        @relation("UserMovements")
    pickedOrderItems       OrderItem[]            @relation("ItemPicker")
    controlledInboundItems InboundContainerItem[] @relation("UserControlledItems")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("users")
}

// ==========================================
// DEPÓSITOS Y UBICACIONES FÍSICAS
// ==========================================

model Warehouse {
    id       String  @id @default(uuid()) @db.Uuid
    code     String  @unique @db.VarChar(20)
    name     String  @db.VarChar(150)
    address  String? @db.VarChar(255)
    isActive Boolean @default(true) @map("is_active")

    locations         Location[]
    inventories       Inventory[]
    sourceOrders      Order[]            @relation("SourceWarehouse")
    stockMovements    StockMovement[]
    inboundContainers InboundContainer[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("warehouses")
}

model Location {
    id          String       @id @default(uuid()) @db.Uuid
    warehouseId String       @map("warehouse_id") @db.Uuid
    code        String       @db.VarChar(50)
    aisle       String       @db.VarChar(20)
    rack        String       @db.VarChar(10)
    position    String       @db.VarChar(10)
    capacity    Int          @default(0)
    type        LocationType @default(STORAGE)
    notes       String?      @db.VarChar(255)
    isBlocked   Boolean      @default(false) @map("is_blocked")

    warehouse       Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
    inventories     Inventory[]
    sourceMovements StockMovement[]        @relation("SourceLocation")
    targetMovements StockMovement[]        @relation("TargetLocation")
    containerItems  InboundContainerItem[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([warehouseId, code])
    @@index([warehouseId])
    @@map("locations")
}

// ==========================================
// CATÁLOGO DE PRODUCTOS E INVENTARIO
// ==========================================

model Product {
    id          String  @id @default(uuid()) @db.Uuid
    sku         String  @unique @db.VarChar(100)
    barcode     String? @unique @db.VarChar(100)
    name        String  @db.VarChar(200)
    description String? @db.Text
    unitsPerBox Int     @default(1) @map("units_per_box")
    unitPrice   Decimal @default(0.00) @map("unit_price") @db.Decimal(12, 2)
    weightKg    Decimal @default(0.00) @map("weight_kg") @db.Decimal(10, 2)
    volumeM3    Decimal @default(0.00) @map("volume_m3") @db.Decimal(10, 4)

    inventories    Inventory[]
    orderItems     OrderItem[]
    movements      StockMovement[]
    containerItems InboundContainerItem[]

    // Relación de Combos (Padre / Hijo)
    comboParentItems ComboComponent[] @relation("ParentProduct")
    comboChildItems  ComboComponent[] @relation("ChildProduct")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([barcode])
    @@map("products")
}

model ComboComponent {
    id               String @id @default(uuid()) @db.Uuid
    parentProductId  String @map("parent_product_id") @db.Uuid
    childProductId   String @map("child_product_id") @db.Uuid
    quantityPerCombo Int    @default(1) @map("quantity_per_combo")

    parentProduct Product @relation("ParentProduct", fields: [parentProductId], references: [id], onDelete: Cascade)
    childProduct  Product @relation("ChildProduct", fields: [childProductId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now()) @map("created_at")

    @@unique([parentProductId, childProductId])
    @@map("combo_components")
}

model Inventory {
    id          String    @id @default(uuid()) @db.Uuid
    warehouseId String    @map("warehouse_id") @db.Uuid
    locationId  String    @map("location_id") @db.Uuid
    productId   String    @map("product_id") @db.Uuid
    lotNumber   String?   @map("lot_number") @db.VarChar(100)
    expiresAt   DateTime? @map("expires_at")

    quantity Int @default(0)
    reserved Int @default(0)

    warehouse Warehouse @relation(fields: [warehouseId], references: [id])
    location  Location  @relation(fields: [locationId], references: [id])
    product   Product   @relation(fields: [productId], references: [id])

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([locationId, productId, lotNumber])
    @@index([warehouseId, productId])
    @@map("inventories")
}

model StockMovement {
    id               String       @id @default(uuid()) @db.Uuid
    warehouseId      String       @map("warehouse_id") @db.Uuid
    productId        String       @map("product_id") @db.Uuid
    sourceLocationId String?      @map("source_location_id") @db.Uuid
    targetLocationId String?      @map("target_location_id") @db.Uuid
    userId           String       @map("user_id") @db.Uuid
    quantity         Int
    type             MovementType
    referenceCode    String?      @map("reference_code") @db.VarChar(100)

    warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
    product        Product   @relation(fields: [productId], references: [id])
    sourceLocation Location? @relation("SourceLocation", fields: [sourceLocationId], references: [id])
    targetLocation Location? @relation("TargetLocation", fields: [targetLocationId], references: [id])
    user           User      @relation("UserMovements", fields: [userId], references: [id])

    createdAt DateTime @default(now()) @map("created_at")

    @@index([warehouseId, productId])
    @@map("stock_movements")
}

// ==========================================
// CONTENEDORES E INBOUND (PACKING LIST)
// ==========================================

model InboundContainer {
    id              String        @id @default(uuid()) @db.Uuid
    containerNumber String        @map("container_number") @db.VarChar(100)
    warehouseId     String        @map("warehouse_id") @db.Uuid
    status          InboundStatus @default(PENDIENTE)
    arrivalDate     DateTime?     @map("arrival_date")
    dischargeDate   DateTime?     @map("discharge_date")
    notes           String?       @db.Text

    warehouse Warehouse              @relation(fields: [warehouseId], references: [id])
    items     InboundContainerItem[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("inbound_containers")
}

model InboundContainerItem {
    id          String  @id @default(uuid()) @db.Uuid
    containerId String  @map("container_id") @db.Uuid
    productId   String? @map("product_id") @db.Uuid
    locationId  String? @map("location_id") @db.Uuid

    sku              String  @db.VarChar(100)
    description      String  @db.VarChar(200)
    quantityBultos   Int     @default(0) @map("quantity_bultos")
    unitsPerBox      Int     @default(1) @map("units_per_box")
    totalUnits       Int     @default(0) @map("total_units")
    weightPerBultoKg Decimal @default(0.00) @map("weight_per_bulto_kg") @db.Decimal(10, 2)
    volumePerBultoM3 Decimal @default(0.00) @map("volume_per_bulto_m3") @db.Decimal(10, 4)
    sampleUnits      Int     @default(0) @map("sample_units")
    imageUrl         String? @map("image_url") @db.VarChar(255)
    notes            String? @db.Text
    rawComponents    Json?   @map("raw_components")

    // Trazabilidad de Auditoría
    isControlled   Boolean   @default(false) @map("is_controlled")
    controlledById String?   @map("controlled_by_id") @db.Uuid
    controlledAt   DateTime? @map("controlled_at")

    container    InboundContainer @relation(fields: [containerId], references: [id], onDelete: Cascade)
    product      Product?         @relation(fields: [productId], references: [id])
    location     Location?        @relation(fields: [locationId], references: [id])
    controlledBy User?            @relation("UserControlledItems", fields: [controlledById], references: [id])

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("inbound_container_items")
}

// ==========================================
// TRANSPORTES EXTERNOS
// ==========================================

model Transport {
    id            String  @id @default(uuid()) @db.Uuid
    name          String  @db.VarChar(200)
    address       String  @db.VarChar(255)
    phone         String? @db.VarChar(50)
    businessHours String? @map("business_hours") @db.VarChar(150)

    customers Customer[]
    orders    Order[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("transports")
}

// ==========================================
// CLIENTES Y DIRECCIONES
// ==========================================

model Customer {
    id             String       @id @default(uuid()) @db.Uuid
    customerNumber String       @unique @map("customer_number") @db.VarChar(50)
    cuit           String       @unique @db.VarChar(20)
    name           String       @db.VarChar(200)
    legalName      String       @map("legal_name") @db.VarChar(200)
    email          String       @db.VarChar(255)
    phone          String?      @db.VarChar(50)
    contactPerson  String?      @map("contact_person") @db.VarChar(150)
    type           CustomerType @default(RETAILER)
    taxCondition   TaxCondition @default(RESPONSABLE_INSCRIPTO) @map("tax_condition")
    logisticsFee   Decimal      @default(0.00) @map("logistics_fee") @db.Decimal(10, 2)
    isActive       Boolean      @default(true) @map("is_active")

    // Alertas de Cliente Crítico
    isCritical     Boolean @default(false) @map("is_critical")
    criticalReason String? @map("critical_reason") @db.Text

    transportId String? @map("transport_id") @db.Uuid

    transport Transport?        @relation(fields: [transportId], references: [id])
    addresses CustomerAddress[]
    orders    Order[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([cuit])
    @@index([customerNumber])
    @@index([isCritical])
    @@map("customers")
}

model CustomerAddress {
    id            String  @id @default(uuid()) @db.Uuid
    customerId    String  @map("customer_id") @db.Uuid
    address       String  @db.VarChar(255)
    city          String  @db.VarChar(100)
    province      String  @db.VarChar(100)
    zipCode       String  @map("zip_code") @db.VarChar(20)
    businessHours String? @map("business_hours") @db.VarChar(150)
    isDefault     Boolean @default(false) @map("is_default")

    customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
    orders   Order[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("customer_addresses")
}

// ==========================================
// PEDIDOS Y PICKING
// ==========================================

model Order {
    id                String  @id @default(uuid()) @db.Uuid
    orderNumber       String  @unique @map("order_number") @db.VarChar(50)
    customerId        String  @map("customer_id") @db.Uuid
    addressId         String  @map("address_id") @db.Uuid
    sourceWarehouseId String  @map("source_warehouse_id") @db.Uuid
    sellerId          String? @map("seller_id") @db.Uuid
    pickerId          String? @map("picker_id") @db.Uuid
    routeId           String? @map("route_id") @db.Uuid
    transportId       String? @map("transport_id") @db.Uuid

    currency    Currency    @default(ARS)
    paymentTerm PaymentTerm @default(CUENTA_CORRIENTE) @map("payment_term")
    status      OrderStatus @default(PENDING)

    deliveryDateFrom DateTime? @map("delivery_date_from") @db.Date
    deliveryDateTo   DateTime? @map("delivery_date_to") @db.Date

    totalBultos   Int     @default(0) @map("total_bultos")
    totalWeightKg Decimal @default(0.00) @map("total_weight_kg") @db.Decimal(10, 2)
    totalAmount   Decimal @default(0.00) @map("total_amount") @db.Decimal(12, 2)

    customer        Customer        @relation(fields: [customerId], references: [id])
    deliveryAddress CustomerAddress @relation(fields: [addressId], references: [id])
    sourceWarehouse Warehouse       @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
    seller          User?           @relation("SellerOrders", fields: [sellerId], references: [id])
    picker          User?           @relation("PickerOrders", fields: [pickerId], references: [id])
    route           Route?          @relation(fields: [routeId], references: [id])
    transport       Transport?      @relation(fields: [transportId], references: [id])
    items           OrderItem[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([status])
    @@index([sourceWarehouseId])
    @@map("orders")
}

model OrderItem {
    id        String  @id @default(uuid()) @db.Uuid
    orderId   String  @map("order_id") @db.Uuid
    productId String  @map("product_id") @db.Uuid
    pickerId  String? @map("picker_id") @db.Uuid

    bultos     Int
    totalUnits Int     @map("total_units")
    unitPrice  Decimal @default(0.00) @map("unit_price") @db.Decimal(12, 2)
    pickedQty  Int     @default(0) @map("picked_qty")

    order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
    product Product @relation(fields: [productId], references: [id])
    picker  User?   @relation("ItemPicker", fields: [pickerId], references: [id])

    @@unique([orderId, productId])
    @@map("order_items")
}

// ==========================================
// LOGÍSTICA Y RUTEO
// ==========================================

model Route {
    id            String      @id @default(uuid()) @db.Uuid
    code          String      @unique @db.VarChar(50)
    driverId      String      @map("driver_id") @db.Uuid
    vehicleInfo   String?     @map("vehicle_info") @db.VarChar(100)
    status        RouteStatus @default(PLANNED)
    scheduledDate DateTime    @map("scheduled_date") @db.Date

    driver User    @relation("DriverRoutes", fields: [driverId], references: [id])
    orders Order[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("routes")
}
