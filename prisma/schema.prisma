// prisma/schema.prisma

// prisma/schema.prisma

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
    ADMIN
    WAREHOUSE_MANAGER
    PICKER
    DRIVER
}

enum OrderStatus {
    PENDING
    IN_PICKING
    PICKED
    DISPATCHED
    DELIVERED
    CANCELLED
}

enum MovementType {
    INBOUND // Recepción de mercadería
    OUTBOUND // Salida por venta/despacho
    TRANSFER_IN // Entrada por transferencia inter-depósito
    TRANSFER_OUT // Salida por transferencia inter-depósito
    ADJUSTMENT // Corrección por inventario físico
}

enum LocationType {
    RECEIVING // Zona de recepción / muelle
    STORAGE // Almacenamiento estándar
    PICKING // Ubicación rápida de picking
    DISPATCH // Zona de consolidación y despacho
}

enum RouteStatus {
    PLANNED
    IN_TRANSIT
    COMPLETED
    CANCELLED
}

// ==========================================
// GESTIÓN DE USUARIOS Y ROLES
// ==========================================

model User {
    id        String   @id @default(uuid()) @db.Uuid
    email     String   @unique @db.VarChar(255)
    password  String   @db.VarChar(255)
    firstName String   @map("first_name") @db.VarChar(100)
    lastName  String   @map("last_name") @db.VarChar(100)
    role      UserRole @default(PICKER)
    isActive  Boolean  @default(true) @map("is_active")

    // Relaciones
    assignedOrders Order[]         @relation("PickerOrders")
    routes         Route[]         @relation("DriverRoutes")
    movements      StockMovement[] @relation("UserMovements")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("users")
}

// ==========================================
// DEPÓSITOS Y UBICACIONES FÍSICAS
// ==========================================

model Warehouse {
    id       String  @id @default(uuid()) @db.Uuid
    code     String  @unique @db.VarChar(20) // Ej: "CHILE-1", "CHILE-2", "MURGUINDO", "ARMENIA", "MOLINEDO"
    name     String  @db.VarChar(150)
    address  String? @db.VarChar(255)
    isActive Boolean @default(true) @map("is_active")

    // Relaciones
    locations      Location[]
    inventories    Inventory[]
    sourceOrders   Order[]         @relation("SourceWarehouse")
    stockMovements StockMovement[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("warehouses")
}

model Location {
    id          String       @id @default(uuid()) @db.Uuid
    warehouseId String       @map("warehouse_id") @db.Uuid
    code        String       @db.VarChar(50) // Ej: "PAS-F-RACK-A-POS-01"
    aisle       String       @db.VarChar(20) // "pas. D" al "pas. K", "tech. dev", "tech ofi"
    rack        String       @db.VarChar(10) // "A" (Piso), "B" (2do nivel), "C" (3er nivel)
    position    String       @db.VarChar(10) // Posición numerada
    type        LocationType @default(STORAGE)
    notes       String?      @db.VarChar(255) // Ej: "enfrente del baño", "cerca del portón"
    isBlocked   Boolean      @default(false) @map("is_blocked")

    // Relaciones
    warehouse       Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
    inventories     Inventory[]
    sourceMovements StockMovement[] @relation("SourceLocation")
    targetMovements StockMovement[] @relation("TargetLocation")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([warehouseId, code])
    @@index([warehouseId])
    @@map("locations")
}

// ==========================================
// CATÁLOGO DE PRODUCTOS E INVENTARIO
// ==========================================

model Product {
    id          String  @id @default(uuid()) @db.Uuid
    sku         String  @unique @db.VarChar(100)
    barcode     String? @unique @db.VarChar(100)
    name        String  @db.VarChar(200)
    description String? @db.Text
    weightKg    Decimal @default(0.00) @map("weight_kg") @db.Decimal(10, 2)
    volumeM3    Decimal @default(0.00) @map("volume_m3") @db.Decimal(10, 4)

    // Relaciones
    inventories Inventory[]
    orderItems  OrderItem[]
    movements   StockMovement[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([barcode])
    @@map("products")
}

model Inventory {
    id          String    @id @default(uuid()) @db.Uuid
    warehouseId String    @map("warehouse_id") @db.Uuid
    locationId  String    @map("location_id") @db.Uuid
    productId   String    @map("product_id") @db.Uuid
    lotNumber   String?   @map("lot_number") @db.VarChar(100)
    expiresAt   DateTime? @map("expires_at")

    // Control estricto de Stock
    quantity Int @default(0) // Stock físico real
    reserved Int @default(0) // Stock reservado para picking en curso

    // Relaciones
    warehouse Warehouse @relation(fields: [warehouseId], references: [id])
    location  Location  @relation(fields: [locationId], references: [id])
    product   Product   @relation(fields: [productId], references: [id])

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([locationId, productId, lotNumber])
    @@index([warehouseId, productId])
    @@map("inventories")
}

model StockMovement {
    id               String       @id @default(uuid()) @db.Uuid
    warehouseId      String       @map("warehouse_id") @db.Uuid
    productId        String       @map("product_id") @db.Uuid
    sourceLocationId String?      @map("source_location_id") @db.Uuid
    targetLocationId String?      @map("target_location_id") @db.Uuid
    userId           String       @map("user_id") @db.Uuid
    quantity         Int
    type             MovementType
    referenceCode    String?      @map("reference_code") @db.VarChar(100)

    // Relaciones
    warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
    product        Product   @relation(fields: [productId], references: [id])
    sourceLocation Location? @relation("SourceLocation", fields: [sourceLocationId], references: [id])
    targetLocation Location? @relation("TargetLocation", fields: [targetLocationId], references: [id])
    user           User      @relation("UserMovements", fields: [userId], references: [id])

    createdAt DateTime @default(now()) @map("created_at")

    @@index([warehouseId, productId])
    @@map("stock_movements")
}

// ==========================================
// CLIENTES, PEDIDOS Y PICKING
// ==========================================

model Customer {
    id      String  @id @default(uuid()) @db.Uuid
    code    String  @unique @db.VarChar(50)
    name    String  @db.VarChar(200)
    email   String  @db.VarChar(255)
    phone   String? @db.VarChar(50)
    address String  @db.VarChar(255)

    orders Order[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("customers")
}

model Order {
    id                String      @id @default(uuid()) @db.Uuid
    orderNumber       String      @unique @map("order_number") @db.VarChar(50)
    customerId        String      @map("customer_id") @db.Uuid
    sourceWarehouseId String      @map("source_warehouse_id") @db.Uuid
    pickerId          String?     @map("picker_id") @db.Uuid
    routeId           String?     @map("route_id") @db.Uuid
    status            OrderStatus @default(PENDING)
    deliveryAddress   String      @map("delivery_address") @db.VarChar(255)

    // Relaciones
    customer        Customer    @relation(fields: [customerId], references: [id])
    sourceWarehouse Warehouse   @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
    picker          User?       @relation("PickerOrders", fields: [pickerId], references: [id])
    route           Route?      @relation(fields: [routeId], references: [id])
    items           OrderItem[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([status])
    @@index([sourceWarehouseId])
    @@map("orders")
}

model OrderItem {
    id        String @id @default(uuid()) @db.Uuid
    orderId   String @map("order_id") @db.Uuid
    productId String @map("product_id") @db.Uuid
    quantity  Int
    pickedQty Int    @default(0) @map("picked_qty")

    // Relaciones
    order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
    product Product @relation(fields: [productId], references: [id])

    @@unique([orderId, productId])
    @@map("order_items")
}

// ==========================================
// LOGÍSTICA Y RUTEO
// ==========================================

model Route {
    id            String      @id @default(uuid()) @db.Uuid
    code          String      @unique @db.VarChar(50)
    driverId      String      @map("driver_id") @db.Uuid
    vehicleInfo   String?     @map("vehicle_info") @db.VarChar(100)
    status        RouteStatus @default(PLANNED)
    scheduledDate DateTime    @map("scheduled_date") @db.Date

    // Relaciones
    driver User    @relation("DriverRoutes", fields: [driverId], references: [id])
    orders Order[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("routes")
}
